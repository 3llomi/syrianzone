#!/bin/sh
# Inertia SSR render server (Node).
#
# Runs by default (SSR is on unless disabled); idles only when
# INERTIA_SSR_ENABLED=false is set explicitly. It listens on 127.0.0.1:13714
# (config/inertia.php). See docs/guidelines/seo.md.
if [ "${INERTIA_SSR_ENABLED}" = "false" ]; then
    echo "Inertia SSR disabled (INERTIA_SSR_ENABLED=false); idling."
    exec sleep infinity
fi

echo "Starting Inertia SSR server..."
exec node /var/www/html/bootstrap/ssr/ssr.js
