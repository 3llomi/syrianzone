#!/bin/sh
# Inertia SSR render server (Node).
#
# Only runs when INERTIA_SSR_ENABLED=true; otherwise it idles so the service
# costs nothing (the app then serves the server-rendered PHP meta instead — see
# docs/guidelines/seo.md). It listens on 127.0.0.1:13714 (config/inertia.php).
if [ "${INERTIA_SSR_ENABLED}" != "true" ]; then
    echo "Inertia SSR disabled (INERTIA_SSR_ENABLED != true); idling."
    exec sleep infinity
fi

echo "Starting Inertia SSR server..."
exec node /var/www/html/bootstrap/ssr/ssr.js
